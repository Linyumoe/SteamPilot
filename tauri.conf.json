{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamPilot",
  "version": "0.1.3",
  "identifier": "com.steampilot.app",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SteamPilot - 蒸汽领航",
        "label": "main",
      "width": 980,
      "height": 700,
      "minWidth": 880,
      "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/nodes/*.txt"]
  }
}
